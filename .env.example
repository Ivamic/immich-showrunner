# immich-showrunner configuration for docker compose.
# Copy this file to .env and adjust the values. Never commit .env.

# Version of the image pulled from ghcr.io. By default "0", the newest 0.x release: then
# `docker compose pull` alone updates the app. Set an exact version only to stay on it.
# SHOWRUNNER_VERSION=0.1.0

# --- Immich -----------------------------------------------------------------------------------

# Address of your Immich server as seen from this machine (LAN address, not localhost).
SHOWRUNNER_IMMICH_URL=http://192.0.2.10:2283

# API key of the Immich user that albums are shared with (create a user for the media server,
# sign in as it, Account Settings -> API Keys). Give the key only these permissions:
#   album.read, asset.read, asset.view, person.read, user.read
SHOWRUNNER_IMMICH_API_KEY=

# --- Folders ----------------------------------------------------------------------------------

# Folder on the host for the links and metadata. Create it first; the app writes only here.
# Add it to Jellyfin as a library of the type "Shows".
SHOWRUNNER_OUTPUT_LOCATION=/srv/showrunner

# Where the media server sees the Immich library: /path-in-Immich=/path-for-the-media-server.
# The left side is the path inside the Immich container (/data since Immich 3; see
# UPLOAD_LOCATION in the .env of Immich for the folder behind it). The right side is that folder
# as Jellyfin sees it: the folder on the host if Jellyfin is installed as a package, or the path
# inside the Jellyfin container. Several pairs are separated by ";" (external libraries).
SHOWRUNNER_PATH_MAP=/data=/srv/immich/library

# Owner of the created links and files: a user and group that the media server can read from.
PUID=1000
PGID=1000

# --- Jellyfin ---------------------------------------------------------------------------------

# Address and API key of Jellyfin (Dashboard -> API Keys). With them, changes show up in Jellyfin
# right after a sync; without them only when Jellyfin scans the library, and changed titles
# not at all.
SHOWRUNNER_JELLYFIN_URL=http://192.0.2.10:8096
SHOWRUNNER_JELLYFIN_API_KEY=

# Where Jellyfin sees the output folder, if not at SHOWRUNNER_OUTPUT_LOCATION (Jellyfin in a
# container with the folder mounted somewhere else).
# SHOWRUNNER_JELLYFIN_OUTPUT_PATH=/media/showrunner

# --- Shows ------------------------------------------------------------------------------------

# A short mark before the title of a show and before the name of a person, so that they stand
# apart from your film library. Empty: no mark.
# SHOWRUNNER_SHOW_PREFIX="◈ "
# SHOWRUNNER_PERSON_PREFIX="◈ "

# The title of a video without a description: its time of filming in this strftime format.
# SHOWRUNNER_TITLE_DATE_FORMAT="%Y-%m-%d %H:%M"

# Seconds between syncs.
# SHOWRUNNER_SYNC_INTERVAL_SECONDS=300

# --- Web page ---------------------------------------------------------------------------------

# Secret that encrypts the Immich key the app keeps for what you do on the page (naming people,
# accepting invitations). At least 32 characters; without it nobody can sign in to the page.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later signs everybody out.
SHOWRUNNER_SECRET_KEY=

# Set to true if the page is served over HTTPS (reverse proxy).
# SHOWRUNNER_COOKIE_SECURE=false

# --- App --------------------------------------------------------------------------------------

# Port of the app on the host, and the address it listens on. By default only this machine can
# reach it; set SHOWRUNNER_BIND=0.0.0.0 to open the page to your home network.
SHOWRUNNER_PORT=8790
# SHOWRUNNER_BIND=0.0.0.0

# Database credentials. Use letters and digits only in the password:
# it is embedded into a connection URL.
DB_USER=showrunner
DB_PASSWORD=change-me
DB_NAME=showrunner
